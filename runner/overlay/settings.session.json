{
  "permissions": {
    "defaultMode": "auto",
    "allow": [],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "node /opt/runner/bin/guard-push.mjs" }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node /opt/runner/bin/sync-workspace.mjs", "timeout": 120 }] },
      { "hooks": [{ "type": "command", "command": "node /opt/runner/bin/report-event.mjs hook" }] }
    ],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node /opt/runner/bin/report-event.mjs hook" }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "node /opt/runner/bin/report-event.mjs hook" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node /opt/runner/bin/report-event.mjs hook" }] }]
  }
}
