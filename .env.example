# Copy to .env.local (gitignored) for local dev. Production values come from Coolify.

NODE_ENV=development
# Postgres. Local: docker-compose.local.yml.
DATABASE_URL=postgres://claudecloud:claudecloud@127.0.0.1:55430/claudecloud
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts secrets at rest. Losing it loses them.
PANEL_ENCRYPTION_KEY=
# The single owner; matched case-insensitively against the Cloudflare Access token email.
ALLOWED_EMAIL=
# Cloudflare Access team domain, e.g. myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Cloudflare Access application AUD tag.
CF_ACCESS_AUD=
# Local dev only: act as this email without a token. Rejected when NODE_ENV=production.
CF_ACCESS_DEV_BYPASS_EMAIL=dev@example.com
# Optional JWKS URL override (tests/e2e). Default: https://<team domain>/cdn-cgi/access/certs
CF_ACCESS_JWKS_URL=
# Public URL of the panel.
PANEL_PUBLIC_URL=http://localhost:3000
# Docker API (through the socket proxy). Default tcp://docker-proxy:2375
DOCKER_HOST=tcp://localhost:2375
# Host stats sidecar. Default http://hoststats:9100
HOSTSTATS_URL=http://localhost:9100
# Runner image used for sessions. Default claudecloud-runner:local
RUNNER_IMAGE=claudecloud-runner:local
# OCI runtime for session containers. Default sysbox-runc
SESSION_RUNTIME=sysbox-runc
# Session config profiles directory. Default /app/configs
CONFIGS_DIR=./configs
# Internal runner API port (never published). Default 3100
RUNNER_API_PORT=3100
# Base URL for all GitHub API calls. Default https://api.github.com
GITHUB_API_URL=https://api.github.com
# e2e only: container REPO_URL template, e.g. file:///repos/{owner}/{name}.git
SESSION_REPO_URL_TEMPLATE=
# Local dev fallbacks when the panel is not on the stack network:
# docker network that session containers join
STACK_NETWORK=
# docker volume holding the shared Claude auth
CLAUDE_AUTH_VOLUME=
